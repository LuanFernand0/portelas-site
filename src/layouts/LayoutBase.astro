---
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
import '../styles/global.css';
interface Props { titulo: string; descricao?: string; ativo?: string }
const { titulo, descricao = "Marcenaria sob medida em Itaipu, Niterói: móveis planejados em MDF, projeto 3D e painéis em PVB.", ativo = '' } = Astro.props;
const WA = 'https://wa.me/5521984592134?text=' + encodeURIComponent("Olá! Vim pelo site e gostaria de um orçamento.");
const itens = [[B + '/', 'inicio', 'Início'], [B + '/galeria', 'galeria', 'Projetos'], [B + '/mostruario', 'mostruario', 'Mostruário de cores'], [B + '/#contato', 'contato', 'Contato']];
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
  <script is:inline set:html={`window.BASE=${JSON.stringify(B)};`}></script>
  <meta name="description" content={descricao} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
  <a href={WA} class="whatsapp-float" target="_blank" rel="noopener" aria-label="Falar no WhatsApp"><i class="fab fa-whatsapp"></i></a>
  <nav class="navbar" aria-label="Principal">
    <div class="container nav-content">
      <a href={`${B}/`} class="logo-portelas" aria-label="Portela's Marcenaria">
        <div class="logo-scale">
          <div class="p-loop"><span class="txt-marcenaria">MARCENARIA</span></div>
          <div class="baixo-container"><div class="p-perna"></div><div class="txt-ortelas">ORTELA'S</div></div>
        </div>
      </a>
      <input type="checkbox" id="nav-toggle" aria-hidden="true" />
      <label for="nav-toggle" class="nav-burger" aria-label="Abrir menu"><i class="fas fa-bars"></i></label>
      <ul class="nav-links">
        {itens.map(([h, id, t]) => <li><a href={h} aria-current={ativo === id ? 'page' : undefined}>{t}</a></li>)}
        <li class="nav-admin"><a href={`${B}/login`}>Administração</a></li>
      </ul>
      <a href={WA} class="btn-orcamento" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i><span>Pedir orçamento</span></a>
    </div>
  </nav>
  <main><slot /></main>
  <footer id="contato" class="footer">
    <div class="container">
      <div class="foot-grid">
        <div>
          <h3>Portela's Marcenaria</h3>
          <p>Móveis sob medida em MDF e compensado, com projeto 3D e painéis em PVB. Fabricação própria em Itaipu, Niterói.</p>
        </div>
        <ul>
          <h3>Fale com a gente</h3>
          <li><i class="fab fa-whatsapp"></i><a href={WA} target="_blank" rel="noopener">(21) 98459-2134</a></li>
          <li><i class="fas fa-envelope"></i><a href="mailto:portelasmarcenaria@gmail.com">portelasmarcenaria@gmail.com</a></li>
        </ul>
        <ul>
          <h3>Onde estamos</h3>
          <li><i class="fas fa-location-dot"></i><span>Estrada Francisco da Cruz Nunes, 2254, Loja 102<br />Itaipu, Niterói - RJ</span></li>
        </ul>
      </div>
      <p class="copy">&copy; 2026 Portela's Marcenaria. Todos os direitos reservados.</p>
    </div>
  </footer>
</body>
</html>